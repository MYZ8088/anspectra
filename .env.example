# Local defaults: docker-compose overrides these internally with container hostnames.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anspectra
CLICKHOUSE_URL=http://localhost:8123
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# App mode: overridden automatically by pnpm local (forces "local") and docker-compose (forces "self-host")
ANSPECTRA_APP_MODE=local

# Docker service defaults used by `pnpm self-host`
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=anspectra
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# App secrets
# `pnpm local`, `pnpm auth`, and `pnpm self-host` auto-generate these when
# creating a fresh `.env` from this template.
BETTER_AUTH_SECRET=replace-me
INTERNAL_CRON_SECRET=replace-me

# Google OAuth: required for Google sign-in to the Anspectra web app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OpenAI-compatible model connection used for structured analysis.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional remote collector mode. Browser cookies and profiles remain local.
COLLECTOR_API_URL=
COLLECTOR_DEVICE_TOKEN=

# Optional agent/runtime overrides
# DEBUG_ENABLED=true
# COLLECTOR_PROVIDER_CONCURRENCY=4
# COLLECTOR_ANALYSIS_CONCURRENCY=2
# CAMOUFOX_HEADLESS_MODE=headless
# CAMOUFOX_PYTHON_BIN=
# CAMOUFOX_PIP_SPEC=cloverlabs-camoufox==0.5.5
# CAMOUFOX_BROWSER_CHANNEL=official/stable/135.0.1-beta.24

# Self-hosted storage root (volume mount path on the host)
ANSPECTRA_STORAGE_ROOT=/opt/anspectra/storage

# Optional: override the published image names (e.g. when self-hosting a fork).
# Defaults point to the official prebuilt images published to GHCR on every release.
ANSPECTRA_AGENT_IMAGE=
ANSPECTRA_WEB_IMAGE=
ANSPECTRA_POSTGRES_IMAGE=
