# Local defaults: docker-compose overrides these internally with container hostnames.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/answerloom
CLICKHOUSE_URL=http://localhost:8123
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# App mode: overridden automatically by pnpm local (forces "local") and docker-compose (forces "self-host")
ANSWERLOOM_APP_MODE=local

# Docker service defaults used by `pnpm self-host`
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=answerloom
CLICKHOUSE_DB=answerloom
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# App secrets
# `pnpm local`, `pnpm auth`, and `pnpm self-host` auto-generate these when
# creating a fresh `.env` from this template.
BETTER_AUTH_SECRET=replace-me
INTERNAL_CRON_SECRET=replace-me

# Google OAuth: required for Google sign-in to the AnswerLoom web app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AIHubMix uses OpenAI-compatible chat completions.
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_ANALYSIS_MODEL=deepseek-v4-pro
AIHUBMIX_ANALYSIS_FALLBACK_MODEL=gpt-4.1-mini
# Which LLM to use for response analysis: "openai" (default), "claude", or "aihubmix"
ANALYSIS_LLM_PROVIDER=openai
PUBLISHER_ENCRYPTION_KEY=

# Optional remote collector mode. Browser cookies and profiles remain local.
COLLECTOR_API_URL=
COLLECTOR_DEVICE_TOKEN=

# Optional auth-session upload target used by `pnpm auth` / `pnpm upload:vps`
# If AGENT_AUTH_UPLOAD_URL is not set, the auth helper derives:
#   http://<ANSWERLOOM_VPS_IP>:3333/auth/sessions
ANSWERLOOM_VPS_IP=
AGENT_AUTH_UPLOAD_TOKEN=

# Proxy: required on VPS (direct connection is not permitted)
# AnswerLoom uses ThorData residential proxies. Set your ThorData API endpoint below.
# THORDATA_PROXY_API_URL=
# PROXY_SCHEME=http

# Optional agent/runtime overrides
# DEBUG_ENABLED=true
# CAMOUFOX_HEADLESS_MODE=virtual
# CAMOUFOX_PYTHON_BIN=
# CAMOUFOX_PIP_SPEC=cloverlabs-camoufox==0.5.5
# CAMOUFOX_BROWSER_CHANNEL=official/stable/135.0.1-beta.24

# Self-hosted storage root (volume mount path on the host)
ANSWERLOOM_STORAGE_ROOT=/opt/answerloom/storage

# Optional: override the published image names (e.g. when self-hosting a fork).
# Defaults point to the official prebuilt images published to GHCR on every release.
ANSWERLOOM_AGENT_IMAGE=
ANSWERLOOM_WEB_IMAGE=
ANSWERLOOM_POSTGRES_IMAGE=
