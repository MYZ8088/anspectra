{
	"name": "anspectra",
	"description": "Open-source official-Web GEO detection for Chinese AI platforms",
	"license": "Apache-2.0",
	"homepage": "https://anspectra.pages.dev",
	"private": true,
	"scripts": {
		"build": "pnpm check:english && pnpm check:privacy && turbo build",
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter=@anspectra/web",
		"dev:landing": "turbo dev --filter=@anspectra/landing",
		"dev:agent": "turbo dev --filter=@anspectra/agent",
		"local": "node scripts/run-local.mjs",
		"local:background": "node scripts/local-daemon.mjs start",
		"local:status": "node scripts/local-daemon.mjs status",
		"local:stop": "node scripts/local-daemon.mjs stop",
		"collector": "node scripts/run-collector.mjs",
		"camoufox:setup": "node scripts/camoufox-setup.mjs",
		"camoufox:doctor": "node scripts/camoufox-doctor.mjs",
		"brand:migrate-runtime": "node scripts/migrate-anspectra-runtime.mjs",
		"brand:assets": "node scripts/generate-anspectra-brand-assets.mjs",
		"brand:social-assets": "node scripts/generate-anspectra-social-assets.mjs",
		"demo:two-cycle": "node --env-file=.env packages/db/scripts/seed-two-cycle-demo.mjs",
		"auth": "node scripts/run-auth.mjs",
		"self-host": "node scripts/run-compose.mjs bootstrap",
		"self-host:build": "node scripts/run-compose.mjs up -d --build",
		"self-host:pull": "node scripts/run-compose.mjs pull --ignore-buildable",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"test": "vitest run",
		"test:soak": "node --env-file=.env scripts/run-reliability-soak.mjs",
		"test:soak:same-day": "node --env-file=.env scripts/run-reliability-soak.mjs --profile=same-day",
		"test:soak:72h": "node --env-file=.env scripts/run-reliability-soak.mjs --profile=72h",
		"check:english": "node scripts/check-user-facing-english.mjs",
		"check:privacy": "node scripts/check-repository-privacy.mjs",
		"clean": "turbo clean && rm -rf node_modules",
		"db:generate": "pnpm --filter @anspectra/db db:generate",
		"db:migrate": "pnpm --filter @anspectra/db db:migrate",
		"db:push": "pnpm --filter @anspectra/db db:push",
		"db:studio": "pnpm --filter @anspectra/db db:studio",
		"start:worker": "pnpm --filter=@anspectra/agent start:worker",
		"lint:fix": "biome check . --fix"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/jsdom": "^21.1.7",
		"jsdom": "^26.1.0",
		"knip": "^5.85.0",
		"sharp": "0.34.5",
		"turbo": "^2.3.3",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	},
	"packageManager": "pnpm@10.16.0",
	"engines": {
		"node": ">=20"
	}
}
