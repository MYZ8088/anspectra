{
	"name": "answerloom",
	"description": "The open-source GEO and AI visibility tracker",
	"license": "MIT",
	"homepage": "http://localhost:3000",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter=@answerloom/web",
		"dev:landing": "turbo dev --filter=@answerloom/landing",
		"dev:agent": "turbo dev --filter=@answerloom/agent",
		"local": "node scripts/run-local.mjs",
		"collector": "node scripts/run-collector.mjs",
		"camoufox:setup": "node scripts/camoufox-setup.mjs",
		"camoufox:doctor": "node scripts/camoufox-doctor.mjs",
		"brand:migrate-runtime": "node scripts/migrate-answerloom-runtime.mjs",
		"brand:social-assets": "node scripts/generate-answerloom-social-assets.mjs",
		"auth": "node scripts/run-auth.mjs",
		"upload:vps": "node scripts/run-auth.mjs --upload-existing-only",
		"self-host": "node scripts/run-compose.mjs bootstrap",
		"self-host:build": "node scripts/run-compose.mjs up -d --build",
		"self-host:pull": "node scripts/run-compose.mjs pull --ignore-buildable",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"test": "vitest run",
		"clean": "turbo clean && rm -rf node_modules",
		"db:generate": "pnpm --filter @answerloom/db db:generate",
		"db:migrate": "pnpm --filter @answerloom/db db:migrate",
		"db:push": "pnpm --filter @answerloom/db db:push",
		"db:studio": "pnpm --filter @answerloom/db db:studio",
		"start:worker": "pnpm --filter=@answerloom/agent start:worker",
		"lint:fix": "biome check . --fix"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/jsdom": "^21.1.7",
		"jsdom": "^26.1.0",
		"knip": "^5.85.0",
		"turbo": "^2.3.3",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	},
	"packageManager": "pnpm@10.16.0",
	"engines": {
		"node": ">=20"
	}
}
